generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// North American (and documented Weingarten) animal-attack incident.
/// SQLite locally; field types stay Postgres-ready (no SQLite-only extras).
model Incident {
  id                  String    @id @default(cuid())
  slug                String    @unique
  title               String
  species             String
  subspecies          String?
  occurredAt          DateTime?
  datePrecision       String    @default("unknown")
  dateDisplay         String?
  city                String?
  region              String?
  stateProvince       String?
  country             String    @default("US")
  lat                 Float?
  lng                 Float?
  severity            String
  summary             String
  sourceType          String
  verified            Boolean   @default(false)
  firearmType         String?
  caliber             String?
  shotsFired          Int?
  defenseOutcome      String?
  combinationDefense  Boolean   @default(false)
  attribution         String?
  externalKey         String    @unique
  publicationId       String?
  publication         Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sources             Source[]

  @@index([species])
  @@index([stateProvince])
  @@index([country])
  @@index([severity])
  @@index([occurredAt])
  @@index([caliber])
  @@index([firearmType])
  @@index([publicationId])
}

model Source {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  url        String
  title      String?
  publisher  String?
  createdAt  DateTime @default(now())

  @@index([url])
  @@index([incidentId])
}

model IngestRun {
  id          String   @id @default(cuid())
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  source      String
  dryRun      Boolean  @default(false)
  fetched     Int      @default(0)
  upserted    Int      @default(0)
  skipped     Int      @default(0)
  errors      String?
}

/// US local / small-town online news publication from open directories.
model Publication {
  id                  String    @id @default(cuid())
  name                String
  homepageUrl         String
  domain              String    @unique
  rssUrl              String?
  sitemapUrl          String?
  town                String?
  city                String?
  state               String?
  county              String?
  country             String    @default("US")
  lat                 Float?
  lng                 Float?
  circulationTier     String?
  directorySource     String
  wikidataId          String?
  lastCrawledAt       DateTime?
  lastBackfillAt      DateTime?
  crawlCursor         String?
  robotsStatus        String?
  robotsCheckedAt     DateTime?
  robotsCrawlDelay    Float?
  notes               String?
  enabled             Boolean   @default(true)
  scannedArticleCount Int       @default(0)
  matchCount          Int       @default(0)
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  incidents           Incident[]
  crawls              PublicationCrawl[]

  @@index([state])
  @@index([lastCrawledAt])
  @@index([enabled])
  @@index([circulationTier])
  @@index([matchCount])
}

model PublicationCrawl {
  id             String       @id @default(cuid())
  publicationId  String
  publication    Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  mode           String
  dryRun         Boolean      @default(false)
  fetched        Int          @default(0)
  matched        Int          @default(0)
  upserted       Int          @default(0)
  skipped        Int          @default(0)
  error          String?

  @@index([publicationId])
  @@index([startedAt])
}
