# SQLite (local default)
DATABASE_URL="file:./dev.db"

# Optional: Postgres in production (update prisma/schema.prisma provider to postgresql)
# DATABASE_URL="postgresql://user:pass@host:5432/animalattacks"

# Optional LLM enrichment during ingest
OPENAI_API_KEY=

# Facebook Graph API (optional — ingest falls back to mock if unset)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_IDS=

# Cron / ingest protection for /api/ingest
INGEST_SECRET=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
