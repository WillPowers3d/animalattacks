# --- Database ---
# Local / quickstart default. SQLite file is created by `npx prisma db push`.
DATABASE_URL="file:./dev.db"

# Production (preferred for daily ingest): hosted Postgres.
# Also run `npx tsx scripts/configure-db-provider.ts` (or change
# prisma/schema.prisma provider to "postgresql") before `prisma db push`.
# DATABASE_URL="postgresql://user:pass@host:5432/animalattacks?sslmode=require"

# --- Optional LLM enrichment during ingest (`--enrich` or /api/ingest) ---
OPENAI_API_KEY=

# --- Facebook Graph API (optional public-page ingest) ---
# Long-lived Page token with pages_read_engagement. Without BOTH of these,
# ingest uses clearly labeled mock posts so the pipeline stays testable.
# FACEBOOK_PAGE_IDS = comma-separated numeric Page IDs (or slugs) you are
# allowed to read — e.g. state wildlife agencies / NPS / Parks Canada pages.
# Suggested pages (look up numeric IDs in Meta Business Suite or Graph Explorer):
#   alaskadfg, ColoradoParksandWildlife, MTFWP, WyomingGameandFish,
#   idahofishandgame, YellowstoneNPS, GlacierNPS, RockyNPS, ParksCanada
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_IDS=
# Optional knobs (defaults shown)
# FACEBOOK_GRAPH_VERSION=v19.0
# FACEBOOK_POST_LIMIT=50

# --- Protect POST/GET /api/ingest ---
# Required in production. Vercel Cron sends Authorization: Bearer $CRON_SECRET
# automatically when CRON_SECRET is set in the project.
INGEST_SECRET=
CRON_SECRET=

# Public site (used in metadata / absolute links if needed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local newspaper crawl (optional knobs) ---
# npm run crawl:publications -- --limit=200 --state=MT --since=2020-01-01 --dry-run --backfill
# npm run crawl:cbc            # CBC / Radio-Canada regional (HTTP/1.1 + listing scrape)
# npm run crawl:canada
# npm run crawl:mexico
# npm run crawl:west-backfill  # AK, MT, WY, ID, CO archives only
# npm run crawl:west-retry     # remaining west queue: 300s timeout, concurrency 2, skip dead hosts
# npm run digest               # fatal / injury markdown since last run
# npm run digest -- --fatal-only
# npm run crawl:agencies
# The crawler respects robots.txt, delays ≥1.5s/host, and stores snippets only.
# CRAWL_CONCURRENCY is read by the GitHub Action (default 6). No extra crawl secrets.
# CRON_SECRET / INGEST_SECRET also protect POST /api/publications/crawl (Vercel Cron).
CRAWL_CONCURRENCY=6

